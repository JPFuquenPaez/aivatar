"NSCalendarsUsageDescription" = "Aivatar reads upcoming calendar events on this watch only while the app is open, so your companion can notice your day. Event titles are never stored or sent anywhere.";
"NSCalendarsFullAccessUsageDescription" = "Aivatar reads upcoming calendar events on this watch only while the app is open, so your companion can notice your day. Event titles are never stored or sent anywhere.";
"NSHealthShareUsageDescription" = "Aivatar reads workouts and sleep saved in Health on this watch only while the app is open, so your companion can celebrate with you. Health details are never stored or sent anywhere.";
"NSHealthUpdateUsageDescription" = "Aivatar saves the workouts you start with it (Run with) and your mindful minutes (Sit with) to Health on this watch only. Nothing is sent anywhere.";
"NSLocationWhenInUseUsageDescription" = "Aivatar uses your location once, while the app is open, to read the current weather so your companion can notice the day. Your location is never stored or sent anywhere.";
